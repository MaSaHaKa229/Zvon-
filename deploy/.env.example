# Скопируйте этот файл в .env и поменяйте значения:  cp .env.example .env && nano .env

# Название сервера (видно всем).
ZVON_NAME=Наш сервер

# Вход по аккаунтам. При первом запуске создаётся аккаунт администратора с этим логином и паролем.
# Остальные аккаунты администратор создаёт в приложении: меню сервера → «Панель хоста» → «Аккаунты».
# Свой пароль администратор потом может сменить в профиле — здесь он больше не используется.
ZVON_ADMIN_LOGIN=admin
ZVON_ADMIN_PASSWORD=придумайте-длинный-пароль

# Забыли пароль администратора? Впишите новый в ZVON_ADMIN_PASSWORD, поставьте здесь 1,
# выполните docker compose up -d, войдите и верните 0 (иначе пароль будет сбрасываться при каждом запуске).
ZVON_ADMIN_RESET_PASSWORD=0

# Внешний IP сервера для голоса. auto — определить автоматически.
# Если голос не подключается, впишите сюда IP вашего VPS из панели хостинга.
ZVON_ANNOUNCED_IP=auto

# Адрес веб-версии (без https://). Нужен домен, указывающий на IP сервера.
# Своего домена нет — подойдёт бесплатный вида 203-0-113-10.sslip.io (IP сервера через дефисы).
ZVON_DOMAIN=203-0-113-10.sslip.io

# Порты. Если меняете — откройте новые в брандмауэре.
ZVON_PORT=7777
ZVON_RTC_PORT=40000

# Максимальный размер одного файла, МБ.
ZVON_MAX_UPLOAD_MB=500
